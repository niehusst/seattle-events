{
  "name": "seattle-events-backend",
  "version": "1.0.0",
  "description": "Backend for Seattle Events Web Application",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "build": "vite build",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "keywords": [
    "seattle",
    "events",
    "scraping",
    "graphql"
  ],
  "author": "Qwen Code",
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^4.7.1",
    "@prisma/client": "^4.15.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "graphql": "^16.6.0",
    "helmet": "^6.1.5",
    "node-cron": "^3.0.2",
    "prisma": "^4.15.0",
    "puppeteer": "^19.7.2",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.31",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.1",
    "@types/node": "^18.15.11",
    "@types/node-cron": "^3.0.8",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.38.0",
    "jest": "^29.5.0",
    "nodemon": "^2.0.22",
    "prettier": "^2.8.7",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.1",
    "tsx": "^4.20.6",
    "typescript": "^4.9.5",
    "vite": "^7.1.7"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/?(*.)+(spec|test).ts?(x)",
      "**/tests/**/*.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/testUtils.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "transform": {
      "^.+\\\\.tsx?$": "ts-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  }
}
