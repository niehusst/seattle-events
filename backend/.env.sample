# Database
DB_NAME="seattle_events"
DB_USER="username"
DB_PASS="password"
DATABASE_URL="postgresql://username:password@localhost:5432/seattle_events"

# Application
PORT=4000
NODE_ENV=development

# Scraping Configuration
SCRAPE_INTERVAL="0 2 * * *"  # Daily at 2 AM
HEADLESS_BROWSER=true
MAX_RETRIES=3
